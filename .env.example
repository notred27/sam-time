# Postgres connection string (Neon: Vercel dashboard -> Storage -> Neon, or neon.tech)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Who you're waiting for (shown on the panel and website)
FRIEND_NAME=Jake

# Discord app: https://discord.com/developers/applications -> your app -> General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot tab -> Reset Token. Used to post/edit the pinned button panel and register commands.
DISCORD_BOT_TOKEN=
# Optional: register commands to one server only (shows up instantly while testing)
DISCORD_GUILD_ID=

# Optional: channel webhook (Channel Settings -> Integrations -> Webhooks).
# When someone starts/ends a wait from the website, it gets announced here.
DISCORD_WEBHOOK_URL=

# Optional: if set, the website asks for this code before it lets anyone start/end a wait.
WEB_PASSCODE=
